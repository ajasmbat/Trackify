{
  "name": "@trackify/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./crypto": "./src/crypto.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "push": "dotenv -e ../../.env -- drizzle-kit push",
    "seed": "dotenv -e ../../.env -- tsx src/seed.ts"
  },
  "dependencies": {
    "@trackify/shared": "workspace:*",
    "drizzle-orm": "^0.33.0",
    "libsodium-wrappers": "^0.7.15",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/libsodium-wrappers": "^0.7.14",
    "@types/pg": "^8.11.6",
    "drizzle-kit": "^0.24.2",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  }
}
