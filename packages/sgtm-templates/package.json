{
  "name": "@trackify/sgtm-templates",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./base-container.json": "./src/base-container.json"
